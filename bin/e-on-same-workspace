#!/usr/bin/env bash

################################################################################
set -eu
set -o pipefail

################################################################################
function usage() {
  cat <<EOF
Usage: $(basename "$0") [options] window-id window-id

  -h      This message

Exit with success if the two Emacs windows are on the same workspace
(virtual desktop).

EOF
}

################################################################################
function main() {
  if [ $# -ne 2 ]; then
    echo >&2 "ERROR: must give exactly two window IDs"
    exit 255
  fi

  if type niri >/dev/null 2>&1; then
    count=$(
      niri msg --json windows |
        jq \
          --arg win1 "$1" \
          --arg win2 "$2" \
          'map(
         select(.app_id == "emacs" and
                (.title | test("\\[\($win1)|\($win2)\\]$")))
       ) |
       map(.workspace_id) |
       unique | length'
    )

    if [ "$count" -ne 1 ]; then
      exit 1
    fi
  fi
}

################################################################################
main "$@"
