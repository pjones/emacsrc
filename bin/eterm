#!/usr/bin/env bash

################################################################################
# Open an Emacs frame running a terminal.
set -eu
set -o pipefail

################################################################################
option_cmd=
option_funcall='(pjones:vterm-frame)'
option_args=()

################################################################################
usage() {
  cat <<EOF
Usage: $(basename "$0") [options]

  -e CMD  Run CMD instead of a shell
  -k      Keep the window after CMD finishes
  -h      This message
  -m      Blank the mode-line

EOF
}

################################################################################
while getopts "he:km" o; do
  case "${o}" in
  e)
    option_cmd=$OPTARG
    ;;

  k)
    option_args+=(":keep t")
    ;;

  h)
    usage
    exit
    ;;

  m)
    option_args+=(":no-mode-line t")
    ;;

  *)
    exit 1
    ;;
  esac
done

shift $((OPTIND - 1))

################################################################################
if [ $# -gt 0 ]; then
  echo >&2 "ERROR: invalid option: $*"
  exit 1
fi

if [ -n "$option_cmd" ]; then
  option_funcall="(pjones:vterm-frame-cmd \"${option_cmd//\"/}\" ${option_args[*]})"
fi

e -- \
  --eval "(require 'vterm)" \
  --eval "$option_funcall" \
  >/dev/null
