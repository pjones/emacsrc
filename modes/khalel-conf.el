;;; khalel-conf.el -- Settings for `khalel' -*- lexical-binding: t -*-
;;
;;; Commentary:
;;
;;; Code:

(require 'khalel)
(require 'org)

(custom-set-variables
 '(khalel-default-alarm "15")
 '(khalel-default-calendar "Peter")
 '(khalel-import-org-file-read-only nil)
 '(khalel-import-org-file-confirm-overwrite nil)
 '(khalel-import-org-file (concat pjones:org-notes-directory
                                  "gtd/calendar.org"))
 '(khalel-import-org-file-header
   ":PROPERTIES:\n:CATEGORY: Calendar\n:END:
#+TITLE: khalel imported calendar events
#+COLUMNS: %ITEM %TIMESTAMP %LOCATION %CALENDAR\n
*NOTE*: This file has been generated by khalel-import-events.\n\n"))

;;; khalel-conf.el ends here
